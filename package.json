{
  "name": "kefania-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Kefania pull-request drafting and publishing MCP server",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "stdio": "node src/index.js",
    "start:http": "node src/index.js --http",
    "pr:local": "node src/local-pr.js",
    "setup:github": "node src/setup-github.js",
    "setup:web": "node src/setup-web.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
